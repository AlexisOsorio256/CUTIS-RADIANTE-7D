# Panel /admin (todo en la propia página, sin bases externas)
# Se configuran en Vercel > Settings > Environment Variables.
ADMIN_PASSWORD=la-contrasena-del-admin
# Para que el admin pueda guardar cambios y subir fotos:
# token de GitHub con permiso Contents (lectura y escritura) solo en este repo.
GITHUB_TOKEN=github_pat_...
# Opcional (por defecto este repo):
